PORT=3000
DATABASE_URL=postgres://ticket_tracker:dev_only_password@localhost:5432/ticket_tracker
WEB_ORIGIN=http://localhost:5173

# --- Auth (spec 10) ---
# Required. At least 32 bytes; the API refuses to boot without it, and rotating it logs
# everyone out. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_JWT_SECRET=replace-me-with-at-least-32-bytes-of-random
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_INVITE_TTL=7d
# Login / invite-accept rate limit, per ip+email. Defaults to the spec's 10 per 15 minutes when
# unset; raise it only in development, where the e2e suite signs in for real many times per run.
# AUTH_LOGIN_RATE_LIMIT=10
# AUTH_LOGIN_RATE_TTL_MS=900000
# Honours the legacy X-Acting-User-Id header. Refused at boot when NODE_ENV=production.
# Off since M21: the web app authenticates for real and nothing needs this. Turn it on only to
# poke the API by hand without signing in — it makes every route reachable as any user.
AUTH_DEV_IMPERSONATION=false

# --- Observability & runtime (spec 11 / M22) ---
# Every variable in this file is validated at boot by src/config/env.ts; a missing or malformed
# one stops the process with a message naming it, rather than failing later under load.
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Server-side budget for a single request. Exceeding it returns 503 with code TIMEOUT.
REQUEST_TIMEOUT_MS=30000
# How long SIGTERM lets in-flight requests drain before the process exits.
SHUTDOWN_TIMEOUT_MS=10000
# Max JSON body. Attachments (M33) will not travel through this path.
BODY_LIMIT=1mb
# Swagger is served at /api outside production. Set true to expose it in production as well.
ENABLE_API_DOCS=false
# Unset means the Sentry integration is inert — local runs and CI need no account.
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
